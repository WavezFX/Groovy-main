{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mochi",
  "description": "What the mochi window may do: Tauri's defaults and the 9 Groovy commands its page uses (generated by scripts/command-access.mjs, round 3G item 2).",
  "windows": [
    "mochi"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "allow-context-menu",
    "allow-custom-sound",
    "allow-custom-sounds",
    "allow-desktop-mochi-drag-begin",
    "allow-desktop-mochi-drag-end",
    "allow-desktop-mochi-drag-move",
    "allow-desktop-mochi-info",
    "allow-desktop-mochi-set-asleep",
    "allow-notify-error"
  ]
}
