{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "studio",
  "description": "What the studio window may do: Tauri's defaults and the 20 Groovy commands its page uses (generated by scripts/command-access.mjs, round 3G item 2).",
  "windows": [
    "studio"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "allow-boot",
    "allow-custom-sound",
    "allow-custom-sounds",
    "allow-notify-error",
    "allow-studio-add-workspace",
    "allow-studio-ai-target",
    "allow-studio-ask",
    "allow-studio-delete",
    "allow-studio-git",
    "allow-studio-git-action",
    "allow-studio-history",
    "allow-studio-list",
    "allow-studio-new-project",
    "allow-studio-read",
    "allow-studio-revert",
    "allow-studio-run",
    "allow-studio-search",
    "allow-studio-stop",
    "allow-studio-workspaces",
    "allow-studio-write"
  ]
}
